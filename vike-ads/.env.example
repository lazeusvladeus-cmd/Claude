# ---- Reasoning / copywriting (required for ideation, verification, image QA) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ---- DeepSeek (optional second reasoner; every DeepSeek output is cross-checked) ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
USE_DEEPSEEK=true

# ---- Primary image backend: Nano Banana via Gemini API ----
# AI Studio key (https://aistudio.google.com/apikey), billing enabled on its Cloud project.
GEMINI_API_KEY=
# gemini-3-pro-image-preview = Nano Banana Pro (best text rendering); gemini-2.5-flash-image = Nano Banana
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# "aistudio" (API key) or "vertex" (uses `gcloud auth print-access-token`)
GOOGLE_IMAGE_BACKEND=aistudio
VERTEX_PROJECT=
VERTEX_LOCATION=global

# ---- Secondary image backend: fal.ai ----
FAL_KEY=
FAL_MODEL=fal-ai/nano-banana-pro

# Vision QA of each rendered image (spelling, no CTA/headline/gradient); retries on failure
IMAGE_QA=true
IMAGE_MAX_ATTEMPTS=2

# ---- Research sources (optional; falls back to OpenAI web search) ----
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Meta Ad Library API token (developers.facebook.com, identity-verified account)
META_AD_LIBRARY_TOKEN=
META_AD_LIBRARY_COUNTRIES=IE,NL
FETCH_PAGES=true

# ---- Weekly research refresh ----
WEEKLY_RESEARCH_DAY=mon
WEEKLY_RESEARCH_HOUR=8
WEEKLY_RESEARCH_TOPIC=
TIMEZONE=Europe/Kyiv

# ---- Dashboard ----
WEB_HOST=127.0.0.1
WEB_PORT=8765
