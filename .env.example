# ---- Telegram ----
# Get this from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Your personal numeric Telegram user ID(s), comma-separated.
# Get yours by messaging @userinfobot on Telegram.
# CRITICAL: only these user IDs will ever be able to talk to the bot.
ALLOWED_TELEGRAM_USER_IDS=

# ---- OpenAI ----
OPENAI_API_KEY=
# Model used for transcription (fixed API, listed for clarity)
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Model used for parsing expenses / generating advice
OPENAI_TEXT_MODEL=gpt-4o-mini

# ---- Google Sheets (storage) ----
# Path to a Google service-account JSON key file (see README setup steps).
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service_account.json
# The Google Sheet ID (from its URL) that the bot will read/write.
# Share this sheet with the service account's client_email as an Editor.
GOOGLE_SHEET_ID=

# ---- Google Calendar (reminders) ----
# Path to OAuth client secret (see README). Only needed once to mint a refresh token.
GOOGLE_OAUTH_CLIENT_FILE=./secrets/oauth_client.json
# Path where the long-lived refresh token is cached after the one-time setup script runs.
GOOGLE_TOKEN_FILE=./secrets/calendar_token.json
# Which calendar to watch. "primary" is your main calendar.
GOOGLE_CALENDAR_ID=primary
# Minutes before an event to send a Telegram reminder.
CALENDAR_REMINDER_MINUTES_BEFORE=20

# ---- Currency ----
# Base currency all statistics/totals are normalized to.
BASE_CURRENCY=USD
# Currencies you actually spend in (comma-separated). Must include BASE_CURRENCY.
TRACKED_CURRENCIES=USD,UAH

# ---- Budget & savings advice (all optional; leave blank to disable) ----
# Optional overall monthly budget in BASE_CURRENCY. Leave blank to disable budget alerts.
MONTHLY_BUDGET=
# Day-of-week (0=Monday) and hour (24h, bot's TZ) to send the weekly savings digest.
WEEKLY_DIGEST_DOW=6
WEEKLY_DIGEST_HOUR=19

# ---- Misc ----
# IANA timezone used for all reminders/digests, e.g. Europe/Kyiv, America/New_York.
TIMEZONE=Europe/Kyiv
# Max OpenAI-backed requests a single user can make per minute (cost/abuse guard).
RATE_LIMIT_PER_MINUTE=15
LOG_LEVEL=INFO
