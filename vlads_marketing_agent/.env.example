# ============================================================================
# Vlad's Marketing — Lead Discovery & Outreach Agent
# Приклад файлу середовища. Скопіюйте цей файл у ".env" і заповніть реальними
# значеннями. Ніколи не комітьте .env у git!
#   cp .env.example .env
# ============================================================================

# --- Google Places API -------------------------------------------------
# Ключ отримується у Google Cloud Console (APIs & Services -> Credentials).
# Детальна інструкція: див. SETUP.md, розділ 4.
GOOGLE_PLACES_API_KEY=

# --- Anthropic (Claude) API ---------------------------------------------
# Ключ отримується на https://console.anthropic.com/settings/keys
# Формат завжди починається з "sk-ant-".
ANTHROPIC_API_KEY=

# Модель Claude, яка використовується для аналізу лідів та генерації текстів.
# Можна змінити без правок коду.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Gmail OAuth ---------------------------------------------------------
# Шлях до файлу credentials.json, завантаженого з Google Cloud Console
# (OAuth 2.0 Client ID, тип "Desktop app"). Див. SETUP.md, розділ 3.
GMAIL_CREDENTIALS_FILE=credentials.json

# Файл, у якому агент зберігає OAuth-токен користувача після першої
# авторизації (створюється автоматично, не редагуйте вручну).
GMAIL_TOKEN_FILE=token.json

# Email-адреса, з якої Vlad's Marketing надсилає (у чернетках) листи.
# Використовується лише для підпису та фільтрації "хто саме відповів".
GMAIL_SENDER_EMAIL=your-address@gmail.com

# --- Локальна база лідів --------------------------------------------------
LEADS_DB_PATH=leads.db

# --- Шлях до конфігурації пошуку лідів ------------------------------------
LEADS_CONFIG_PATH=leads_config.yaml

# --- Модуль 5: моніторинг відповідей --------------------------------------
# Як часто (у хвилинах) перевіряти нові відповіді у режимі --watch.
CHECK_REPLIES_INTERVAL_MINUTES=60

# Куди зберігати згенеровані PPTX-презентації.
PRESENTATIONS_DIR=presentations

# --- Логування -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
